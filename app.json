{
  "expo": {
    "name": "vasApp",
    "slug": "vasApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "static",
      "bundler": "metro",
      "name": "vasApp",
      "shortName": "vasApp",
      "description": "VAS App - Value Added Services mobile wallet",
      "themeColor": "#1a1a2e",
      "backgroundColor": "#ffffff",
      "lang": "en"
    },
    "plugins": ["expo-router"],
    "scheme": "vasApp"
  }
}
